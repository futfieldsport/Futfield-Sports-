# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# API-Football (API-Sports) key; server-side only.
API_FOOTBALL_KEY="your_api_football_key"

# APP_URL: Canonical production domain or runtime host URL.
APP_URL="https://futfieldsport.com.ng"

# Supabase Backend Database & Auth credentials
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Paystack Worldwide Subscription Gateway
# Secret key stays strictly server-side; Public key is safe for Paystack Inline JS
PAYSTACK_SECRET_KEY="sk_live_or_test_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_live_or_test_your_paystack_public_key"
VITE_PAYSTACK_PUBLIC_KEY="pk_live_or_test_your_paystack_public_key"

# Optional Netlify CLI headless auth / site sync tokens
NETLIFY_AUTH_TOKEN=""
NETLIFY_SITE_ID=""

